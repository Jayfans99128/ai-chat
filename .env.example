# AI-Girlfriend-Agent 环境配置

# LLM API 配置 （SiliconFlow 示例）
API_KEY=sk-your-key-here
BASE_URL=https://api.siliconflow.cn/v1
MODEL=deepseek-ai/DeepSeek-V4-Flash

# TTS 语音合成配置
# 可选值：mimo（声音克隆）, edge_tts（免费备选）, pyttsx3
TTS_ENGINE=mimo

# MiMo TTS 配置（声音克隆模式）
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
# 声音克隆参考音频（单个文件路径，优先级高于 MIMO_CLONE_REF_DIR）
# MIMO_TTS_VOICE=extract_radio/26185565247-1-30280.wav

# 声音克隆参考音频目录（如果设置了 MIMO_TTS_VOICE，则忽略此配置）
# 目录中的音频文件将被用作克隆参考
MIMO_CLONE_REF_DIR=extract_radio